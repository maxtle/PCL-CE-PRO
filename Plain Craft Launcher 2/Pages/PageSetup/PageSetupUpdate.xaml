<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL"
    xmlns:loc="https://ce.pclc.cc/core/localization"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" x:Class="PCL.PageSetupUpdate"
    PanScroll="{Binding ElementName=PanBack}">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,25,25,10">
            <local:MyCard x:Name="CardVersion" Margin="0,0,0,15" Title="{loc:Loc Setup.Details.Version.Title}">
                <Grid Margin="25,40,25,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="110" />
                        <ColumnDefinition Width="25" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Top" Margin="0,0,0,10"
                               Text="{loc:Loc Setup.Details.Version.Name}" />
                    <TextBlock Grid.Row="0" Grid.Column="2" x:Name="LabVersionName" VerticalAlignment="Top" Margin="0,0,0,10"
                               TextWrapping="Wrap" />
                    <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Top" Margin="0,0,0,10"
                               Text="{loc:Loc Setup.Details.Version.Code}" />
                    <TextBlock Grid.Row="1" Grid.Column="2" x:Name="LabVersionCode" VerticalAlignment="Top" Margin="0,0,0,10"
                               TextWrapping="Wrap" />
                    <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Top" Margin="0,0,0,10"
                               Text="{loc:Loc Setup.Details.Version.Branch}" />
                    <TextBlock Grid.Row="2" Grid.Column="2" x:Name="LabVersionBranch" VerticalAlignment="Top" Margin="0,0,0,10"
                               TextWrapping="Wrap" />
                    <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Top" Margin="0,0,0,10"
                               Text="{loc:Loc Setup.Details.Version.DotNet}" />
                    <TextBlock Grid.Row="3" Grid.Column="2" x:Name="LabDotNetVersion" VerticalAlignment="Top" Margin="0,0,0,10"
                               TextWrapping="Wrap" />
                    <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Top" Margin="0,0,0,10"
                               Text="{loc:Loc Setup.Details.Version.Os}" />
                    <TextBlock Grid.Row="4" Grid.Column="2" x:Name="LabOsVersion" VerticalAlignment="Top" Margin="0,0,0,10"
                               TextWrapping="Wrap" />
                    <TextBlock Grid.Row="5" Grid.Column="0" VerticalAlignment="Top" Margin="0,0,0,10"
                               Text="{loc:Loc Setup.Details.Version.Arch}" />
                    <TextBlock Grid.Row="5" Grid.Column="2" x:Name="LabArchitecture" VerticalAlignment="Top" Margin="0,0,0,10"
                               TextWrapping="Wrap" />
                    <TextBlock Grid.Row="6" Grid.Column="0" VerticalAlignment="Top" Margin="0,0,0,10"
                               Text="{loc:Loc Setup.Details.Version.Dpi}" />
                    <TextBlock Grid.Row="6" Grid.Column="2" x:Name="LabScreenDpi" VerticalAlignment="Top" Margin="0,0,0,10"
                               TextWrapping="Wrap" />
                    <TextBlock Grid.Row="7" Grid.Column="0" VerticalAlignment="Top" Margin="0,0,0,10"
                               Text="{loc:Loc Setup.Details.Version.ExePath}" />
                    <TextBlock Grid.Row="7" Grid.Column="2" x:Name="LabExePath" VerticalAlignment="Top" Margin="0,0,0,10"
                               TextWrapping="Wrap" />
                    <TextBlock Grid.Row="8" Grid.Column="0" VerticalAlignment="Top" Margin="0,0,0,10"
                               Text="{loc:Loc Setup.Details.Version.DataPath}" />
                    <TextBlock Grid.Row="8" Grid.Column="2" x:Name="LabDataPath" VerticalAlignment="Top" Margin="0,0,0,10"
                               TextWrapping="Wrap" />
                    <TextBlock Grid.Row="9" Grid.Column="0" VerticalAlignment="Top"
                               Text="{loc:Loc Setup.Details.Version.StartupCount}" />
                    <TextBlock Grid.Row="9" Grid.Column="2" x:Name="LabStartupCount" VerticalAlignment="Top"
                               TextWrapping="Wrap" />
                </Grid>
            </local:MyCard>
            <local:MyCard x:Name="CardUpdate" Margin="0,0,0,15" Title="{loc:Loc Setup.Details.Update.Title}">
                <StackPanel Margin="25,40,25,20">
                    <TextBlock Text="{loc:Loc Setup.Details.Update.Desc}" TextWrapping="Wrap" Opacity="0.7" />
                    <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                        <local:MyButton x:Name="BtnCheckUpdate" MinWidth="120" Height="32" Padding="13,0"
                                        ColorType="Highlight" Text="{loc:Loc Setup.Details.Update.Check}"
                                        Click="BtnCheckUpdate_Click" />
                        <local:MyButton x:Name="BtnOpenReleases" MinWidth="120" Height="32" Padding="13,0"
                                        Margin="10,0,0,0" Visibility="Collapsed"
                                        Text="{loc:Loc Setup.Details.Update.OpenReleases}"
                                        Click="BtnOpenReleases_Click" />
                        <TextBlock x:Name="LabUpdateStatus" VerticalAlignment="Center" Margin="15,0,0,0"
                                   TextWrapping="Wrap" Opacity="0.7" />
                    </StackPanel>
                </StackPanel>
            </local:MyCard>
            <local:MyCard x:Name="CardData" Margin="0,0,0,15" Title="{loc:Loc Setup.Details.Data.Title}">
                <StackPanel Margin="25,40,25,20">
                    <TextBlock Text="{loc:Loc Setup.Details.Data.Desc}" TextWrapping="Wrap" Opacity="0.7"
                               Margin="0,0,0,15" />
                    <local:MyCheckBox x:Name="CheckClearCache" Height="28" Margin="0,0,0,6" Checked="True"
                                      Text="{loc:Loc Setup.Details.Data.Cache}" />
                    <local:MyCheckBox x:Name="CheckClearLog" Height="28" Margin="0,0,0,6" Checked="True"
                                      Text="{loc:Loc Setup.Details.Data.Log}" />
                    <local:MyCheckBox x:Name="CheckClearConfig" Height="28" Margin="0,0,0,15" Checked="False"
                                      Text="{loc:Loc Setup.Details.Data.Config}" />
                    <StackPanel Orientation="Horizontal">
                        <local:MyButton x:Name="BtnClearData" MinWidth="110" Padding="13,0" Height="32"
                                        ColorType="Red" Text="{loc:Loc Setup.Details.Data.Clear}"
                                        Click="BtnClearData_Click" />
                        <TextBlock x:Name="LabClearResult" VerticalAlignment="Center" Margin="15,0,0,0"
                                   TextWrapping="Wrap" Opacity="0.7" />
                    </StackPanel>
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
