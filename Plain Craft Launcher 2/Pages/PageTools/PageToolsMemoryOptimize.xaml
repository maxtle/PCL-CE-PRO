<local:MyPageRight x:Class="PCL.PageToolsMemoryOptimize"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="clr-namespace:PCL"
                   xmlns:loc="https://ce.pclc.cc/core/localization"
                   PanScroll="{Binding ElementName=PanBack}">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,10">
            <local:MyCard Margin="0,15" Title="{loc:Loc Tools.MemoryOptimize.Title}">
                <StackPanel Margin="25,40,25,20">
                    <TextBlock Text="{loc:Loc Tools.MemoryOptimize.Description}" TextWrapping="Wrap" />

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="MemName" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"
                                   Margin="0,0,25,10"
                                   Text="{loc:Loc Tools.MemoryOptimize.PhysicalMemory}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" VerticalAlignment="Center"
                                   Margin="0,0,0,10" x:Name="LabPhysicalMemory" />

                        <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"
                                   Margin="0,0,25,10"
                                   Text="{loc:Loc Tools.MemoryOptimize.LauncherMemory}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" VerticalAlignment="Center"
                                   Margin="0,0,0,10" x:Name="LabLauncherMemory" />

                        <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"
                                   Margin="0,0,25,0"
                                   Text="{loc:Loc Tools.MemoryOptimize.GameMemory}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" VerticalAlignment="Center"
                                   x:Name="LabGameMemory" TextWrapping="Wrap" />
                    </Grid>

                    <local:MyButton x:Name="BtnOptimize" MinWidth="140" Margin="0,20,0,0"
                                    HorizontalAlignment="Left" ColorType="Highlight"
                                    Text="{loc:Loc Tools.MemoryOptimize.Optimize}"
                                    Click="BtnOptimize_Click" />

                    <TextBlock x:Name="LabResult" Margin="0,12,0,0" TextWrapping="Wrap" Opacity="0.75" />
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15" Title="{loc:Loc Tools.MemoryOptimize.Auto.Title}">
                <StackPanel Margin="25,40,25,20">
                    <TextBlock Text="{loc:Loc Tools.MemoryOptimize.Auto.Description}"
                               TextWrapping="Wrap" Opacity="0.75" />

                    <local:MyCheckBox x:Name="CheckAutoClean" Height="22" Margin="0,18,0,0"
                                      Text="{loc:Loc Tools.MemoryOptimize.Auto.Enable}"
                                      Change="CheckAutoClean_Change" />

                    <StackPanel x:Name="PanAutoOptions" Margin="0,16,0,0" Visibility="Collapsed">
                        <TextBlock Text="{loc:Loc Tools.MemoryOptimize.Auto.Mode}" Opacity="0.85" />
                        <local:MyComboBox x:Name="ComboAutoMode" Height="32" Width="250"
                                          HorizontalAlignment="Left" Margin="0,9,0,0"
                                          SelectionChanged="ComboAutoMode_Change">
                            <local:MyComboBoxItem Content="{loc:Loc Tools.MemoryOptimize.Auto.Mode.Threshold}" />
                            <local:MyComboBoxItem Content="{loc:Loc Tools.MemoryOptimize.Auto.Mode.Interval}" />
                        </local:MyComboBox>

                        <StackPanel x:Name="PanThreshold" Margin="0,18,0,0">
                            <TextBlock x:Name="LabThreshold" Opacity="0.85" />
                            <local:MySlider x:Name="SliderThreshold" MaxValue="45" ValueByKey="1"
                                            Width="270" HorizontalAlignment="Left" Margin="0,9,0,0"
                                            Change="SliderThreshold_Change" />
                        </StackPanel>

                        <StackPanel x:Name="PanInterval" Margin="0,18,0,0" Visibility="Collapsed">
                            <TextBlock Text="{loc:Loc Tools.MemoryOptimize.Auto.Interval}" Opacity="0.85" />
                            <local:MyComboBox x:Name="ComboInterval" Height="32" Width="250"
                                              HorizontalAlignment="Left" Margin="0,9,0,0"
                                              SelectionChanged="ComboInterval_Change" />
                        </StackPanel>

                        <TextBlock x:Name="LabAutoStatus" Margin="0,14,0,0" TextWrapping="Wrap" Opacity="0.7" />
                    </StackPanel>
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
